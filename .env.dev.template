# =============================================================================
# AIOS DEV-CHASSIS .env TEMPLATE  (Phase 5 smoke test)
# =============================================================================
# This is a TEMPLATE. To use it:
#   1. Copy it to ".env" AT THIS CHASSIS ROOT:
#        I:\PROJECTS\AIOS\hermes-agent\.env
#   2. Fill ONLY the keys you need for the chosen smoke option (A or B below).
#   3. NEVER copy real secrets into the *.template file itself.
#
# WHY THE CHASSIS ROOT (and NOT hermes-home):
#   cli.py loads the chassis-root .env as the project_env fallback
#   (cli.py: _project_env = Path(__file__).parent / '.env'). The dev
#   HERMES_HOME (I:\PROJECTS\AIOS\hermes-home) MUST stay .env-free: the
#   isolation gate (preflight-isolation.ps1, invariants e3 + h) BLOCKS the
#   launch if ANY .env exists under hermes-home. So the dev .env lives HERE.
#
# CRITICAL - CHANNEL TOKENS ARE OMITTED ON PURPOSE:
#   The chassis reads BOTH model keys AND channel/bot tokens from the SAME
#   .env namespace. For an isolated smoke we DELIBERATELY include model keys
#   ONLY and EXCLUDE every channel token (SLACK_*, TELEGRAM_*, DISCORD_*,
#   MATRIX_*, WHATSAPP_*, EMAIL_*, TEAMS_*, GOOGLE_CHAT_*). With no channel
#   token present and channels disabled in config.yaml, no gateway message
#   can be consumed and no live channel can be reached.
#
# .gitignore: the chassis .gitignore already ignores .env -- do not commit it.
# =============================================================================


# -----------------------------------------------------------------------------
# OPTION A (PREFERRED): KEY-FREE LOCAL OLLAMA SMOKE
# -----------------------------------------------------------------------------
# NO keys required and NO external egress. A local Ollama model is reached at
# http://localhost:11434/v1, which the chassis classifies as a local endpoint
# (agent/model_metadata.py is_local_endpoint) and serves with a placeholder
# "dummy-key" -- so this whole file can stay EMPTY for Option A.
#
# For Option A you do NOT edit this .env at all. Instead point the DEV config
# at a local model (see RUNBOOK-phase5-smoke.md, Option A), e.g. in
# I:\PROJECTS\AIOS\hermes-home\config.yaml:
#     model:
#       default: "qwen3:14b-q8_0"          # any installed local Ollama model
#       provider: "ollama"                  # alias -> custom (OpenAI-compatible)
#       base_url: "http://localhost:11434/v1"
#       reasoning_effort: high
# Leave every line below COMMENTED for Option A.


# -----------------------------------------------------------------------------
# OPTION B (FALLBACK): API-MODEL SMOKE -- MODEL KEYS ONLY, NO CHANNEL TOKENS
# -----------------------------------------------------------------------------
# Use this ONLY if you want to smoke against a hosted model. Uncomment and
# fill EXACTLY ONE provider key that matches model.default + model.provider in
# the DEV config.yaml. This path makes an EXTERNAL call and costs money.
#
# OpenRouter (one key, many models):
# OPENROUTER_API_KEY=

# Direct Anthropic (provider: anthropic):
# ANTHROPIC_API_KEY=

# Google AI Studio / Gemini (provider: gemini):
# GOOGLE_API_KEY=

# DeepSeek-compatible / other OpenAI-compatible provider key the dev config
# default points at (current dev default is "deepseek-v4-pro" + provider
# "deepseek" -- repoint to a key you actually hold, or prefer Option A):
# DEEPSEEK_API_KEY=

# Generic OpenAI-compatible endpoint (provider: main / custom):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=


# -----------------------------------------------------------------------------
# DO NOT ADD (isolation invariants -- adding any of these can break isolation):
# -----------------------------------------------------------------------------
#   SLACK_BOT_TOKEN / SLACK_APP_TOKEN
#   TELEGRAM_BOT_TOKEN / TELEGRAM_HOME_CHANNEL
#   DISCORD_* / MATRIX_* / WHATSAPP_* / EMAIL_* / TEAMS_* / GOOGLE_CHAT_*
#   Any brain/neurolinked credential or the live brain IP 1.1.11.31
# Channels stay DISABLED in config.yaml; tokens stay OUT of this .env.
# =============================================================================
